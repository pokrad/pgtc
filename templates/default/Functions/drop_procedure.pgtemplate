+++
name        = "Drop procedure"
description = "DROP PROCEDURE (with its argument types)"

[[param]]
name     = "object"
label    = "Procedure"
type     = "choice"
source   = "procedures"
required = true

[[param]]
name  = "if_exists"
label = "IF EXISTS"
type  = "bool"

[[param]]
name    = "behavior"
label   = "Dependent objects"
type    = "choice"
options = ["RESTRICT", "CASCADE"]
default = "RESTRICT"
help    = "CASCADE also drops the objects that depend on it"
+++
DROP PROCEDURE{% if if_exists %} IF EXISTS{% endif %} {{ object|ident }} {{ behavior }};
