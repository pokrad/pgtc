+++
name        = "Create materialized view"
description = "CREATE MATERIALIZED VIEW"

[[param]]
name     = "schema"
label    = "Schema"
type     = "choice"
source   = "schemas"
default  = "public"
required = true

[[param]]
name     = "name"
label    = "View name"
type     = "identifier"
required = true

[[param]]
name     = "query"
label    = "Query"
type     = "sql"
fill     = true
default  = "SELECT 1"
required = true

[[param]]
name    = "with_data"
label   = "WITH DATA"
type    = "bool"
default = true
+++
CREATE MATERIALIZED VIEW {{ schema|ident }}.{{ name|ident }} AS
{{ query }}
{% if with_data %}WITH DATA{% else %}WITH NO DATA{% endif %};
