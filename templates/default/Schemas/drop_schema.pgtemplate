+++
name        = "Drop schema"
description = "DROP SCHEMA"

[[param]]
name     = "object"
label    = "Schema"
type     = "choice"
source   = "schemas"
required = true

[[param]]
name  = "if_exists"
label = "IF EXISTS"
type  = "bool"

[[param]]
name    = "behavior"
label   = "Dependent objects"
type    = "choice"
options = ["RESTRICT", "CASCADE"]
default = "RESTRICT"
help    = "CASCADE also drops the objects that depend on it"
+++
DROP SCHEMA{% if if_exists %} IF EXISTS{% endif %} {{ object|ident }} {{ behavior }};
